# Server Configuration
NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-frontend-app.vercel.app

# MongoDB Connection String (Atlas for production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lost-and-found?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=generate_a_random_secure_secret_here
JWT_EXPIRES_IN=7d

# Admin Seeding (Optional, for initial deployment)
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@campus.com
ADMIN_PASSWORD=Admin@123

# Email Domain Restriction (Optional)
# Set to true in production to restrict registration to college emails
RESTRICT_EMAIL_DOMAIN=false
ALLOWED_EMAIL_DOMAINS=campus.edu,college.edu,university.edu

# Brevo SMTP / Email Notifications (Optional)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_master_password
FROM_EMAIL=no-reply@yourdomain.com
FROM_NAME=Lost & Found Platform

# AI Matching Configuration
# Optional: Gemini API Key for Semantic Image and Text Understanding
GEMINI_API_KEY=your_google_gemini_api_key_here
AI_IMAGE_MATCH_THRESHOLD=80
